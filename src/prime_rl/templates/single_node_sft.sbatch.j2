#!/bin/bash

#SBATCH --job-name={{ job_name }}
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus_per_node }}
#SBATCH --exclusive
#SBATCH --partition={{ partition }}
{%- if account %}
#SBATCH --account={{ account }}
{%- endif %}
{%- if time %}
#SBATCH --time={{ time }}
{%- endif %}
{%- if pause_before_time_limit %}
#SBATCH --signal=B:USR1@{{ pause_before_time_limit }}
{%- endif %}
{%- if nodelist %}
#SBATCH --nodelist={{ nodelist }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}
#SBATCH --output={{ launcher_log_dir }}/job_%j.log
#SBATCH --error={{ launcher_log_dir }}/job_%j.log

# Exit immediately if any setup command or the launcher fails so the SLURM job
# releases its allocation instead of holding nodes after a crash.
set -e

export PROJECT_DIR={{ project_dir }}
export PRL_ATTEMPT_CONFIG_DIR={{ config_dir }}
export PRL_ATTEMPT_LOG_DIR={{ log_dir }}

# Setup environment
cd $PROJECT_DIR
[ -f .env ] && source .env
source .venv/bin/activate
uv sync --all-extras --all-packages

{% if pre_run_command %}
# Pre-run command
{{ pre_run_command }}
{% endif %}
{% if control_port %}export CONTROL_URL="http://localhost:{{ control_port }}"
{% endif %}
{% include '_pause_before_time_limit.sh.j2' %}

# Run in the background so the batch shell can handle the time-limit signal.
uv run sft @ {{ config_path }} &
MAIN_PID=$!
wait_main
exit $EXIT_CODE
