{# Single-pool llm-d routing with the configured scorers. The vllmhttp parser
   handles both OpenAI requests and /inference/v1/generate token IDs. Prefix
   affinity applies only when a prefix scorer is configured. $LLMD_DIR is
   expanded by the launch-time heredoc. #}
apiVersion: inference.networking.x-k8s.io/v1alpha1
kind: EndpointPickerConfig
plugins:
  - name: file-disc
    type: file-discovery
    parameters:
      path: $LLMD_DIR/endpoints.yaml
      watchFile: true
  - name: vllmhttp-parser
    type: vllmhttp-parser
{%- for scorer in router.scorers %}
  - type: {{ scorer }}
{%- endfor %}
  - type: max-score-picker
  - type: single-profile-handler
schedulingProfiles:
  - name: default
    plugins:
{%- for scorer, weight in router.scorers.items() %}
      - pluginRef: {{ scorer }}
        weight: {{ weight }}
{%- endfor %}
      - pluginRef: max-score-picker
requestHandler:
  parser:
    pluginRef: vllmhttp-parser
dataLayer:
  discovery:
    pluginRef: file-disc
